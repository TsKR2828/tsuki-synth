+def _nls_basis_cols(cents, log_tau, f0, sr, n_seg, bin_phasor, hann_phasor):
+    """Exact windowed, zero-padded DFT (sampled at the band bins) of the two
+    real basis waveforms of ONE damped partial at f0*2^(cents/1200) with time
+    constant exp(log_tau):
+        col_a[n] = hann[n] * exp(-n/(tau*sr)) * cos(2*pi*f*n/sr)
+        col_b[n] = hann[n] * exp(-n/(tau*sr)) * -sin(2*pi*f*n/sr)
+    so that a*col_a + b*col_b spans every amplitude/phase of that partial.
+    np.hanning(L) = 0.5 - 0.5*cos(2*pi*n/(L-1)) splits into three complex
+    exponentials, so each DFT sample is three geometric sums -- computed in
+    closed form instead of an FFT per iteration (that is the only reason this
+    is analytic; the quantity is exactly the DFT numpy would return)."""
+    f = f0 * 2.0 ** (cents / 1200.0)
+    decay = math.exp(-1.0 / (math.exp(log_tau) * sr))
+    out = []
+    for sign in (1.0, -1.0):
+        z = (decay * np.exp(sign * 2j * np.pi * f / sr)) * bin_phasor
+        out.append(0.5 * _nls_geometric_sum(z, n_seg)
+                   - 0.25 * _nls_geometric_sum(z * hann_phasor, n_seg)
+                   - 0.25 * _nls_geometric_sum(z / hann_phasor, n_seg))
+    s_pos, s_neg = out
+    return 0.5 * (s_pos + s_neg), 0.5j * (s_pos - s_neg)
