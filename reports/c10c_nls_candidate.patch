+def _nls_geometric_sum(z, n_terms):
+    """sum_{k=0}^{n_terms-1} z^k, elementwise, with the removable
+    singularity at z == 1 handled explicitly (there the sum is n_terms)."""
+    d = 1.0 - z
+    degenerate = np.abs(d) < 1e-13
+    safe = np.where(degenerate, 1.0, d)
+    return np.where(degenerate, complex(n_terms), (1.0 - z ** n_terms) / safe)
