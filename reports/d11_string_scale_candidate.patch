+    static constexpr int   kPianoScaleAnchorMidi[8] = { 24, 36, 48, 60, 72, 84, 96, 108 };
+    /// 弦長 (m)，C1-C8，docs/STRING_SCALE_SOURCES.md §1（轉引 Woodhouse Table 1）。
+    static constexpr float kPianoScaleLengthM[8]    =
+        { 1.013f, 0.925f, 0.830f, 0.639f, 0.324f, 0.181f, 0.096f, 0.051f };
+    /// 芯線直徑 (m)，C1-C8，同上；C1-C3 見上方纏繞弦限制說明。
+    static constexpr float kPianoScaleDiameterM[8]  =
+        { 0.00121f, 0.00121f, 0.00108f, 0.00100f, 0.00094f, 0.00085f, 0.00082f, 0.00076f };
+
+    /// 與 HammerImpulse.h::interpAnchorsFlat() 同體例的獨立實作（StringModel.h
+    /// 不 include HammerImpulse.h，避免引入非必要的標頭相依）。
+    static float interpScaleAnchorsFlat (const float* values, int midiNote)
+    {
+        const int* anchorMidi = kPianoScaleAnchorMidi;
+        const int  count = 8;
+        if (midiNote <= anchorMidi[0])         return values[0];
+        if (midiNote >= anchorMidi[count - 1]) return values[count - 1];
+
+        int seg = 0;
+        while (seg + 2 < count && midiNote >= anchorMidi[seg + 1])
+            ++seg;
+
+        const float t = (float) (midiNote - anchorMidi[seg])
+                      / (float) (anchorMidi[seg + 1] - anchorMidi[seg]);
+        return values[seg] + (values[seg + 1] - values[seg]) * t;
+    }
