{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsukisynth.local/schema/specimen-acquisition-v1.json",
  "title": "TsukiSynth Specimen Acquisition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "measurement_template", "mode_dump", "channels",
    "structural_records", "evidence"
  ],
  "properties": {
    "$schema": { "const": "TsukiSynth Specimen Acquisition v1" },
    "measurement_template": { "type": "string", "minLength": 1 },
    "mode_dump": { "type": "string", "minLength": 1 },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["force", "structural_response"],
      "properties": {
        "force": {
          "$ref": "#/$defs/force_channel"
        },
        "structural_response": {
          "$ref": "#/$defs/response_channel"
        },
        "microphone": { "$ref": "#/$defs/microphone_channel" }
      }
    },
    "structural_records": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/structural_record" }
    },
    "acoustic_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/acoustic_record" }
    },
    "calibrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_path", "after_path", "frequency_hz", "level_db_re_20upa"],
      "properties": {
        "before_path": { "type": "string", "minLength": 1 },
        "after_path": { "type": "string", "minLength": 1 },
        "microphone_column": { "type": "string", "minLength": 1 },
        "time_column": { "type": "string", "minLength": 1 },
        "frequency_hz": { "type": "number", "exclusiveMinimum": 0 },
        "level_db_re_20upa": { "type": "number" },
        "max_drift_db": { "type": "number", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path"],
        "properties": {
          "role": {
            "enum": ["excitation_calibration", "response_calibration", "acoustic_calibration"]
          },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_partial_indices": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "minimum_averages": { "type": "integer", "minimum": 2 },
        "window": { "type": "string", "minLength": 1 },
        "frequency_search_half_width_hz": { "type": "number", "exclusiveMinimum": 0 },
        "relative_search_half_width": { "type": "number", "minimum": 0 },
        "decay_bandwidth_hz": { "type": "number", "exclusiveMinimum": 0 },
        "decay_fit_upper_db": { "type": "number", "exclusiveMaximum": 0 },
        "decay_fit_lower_db": { "type": "number", "exclusiveMaximum": 0 },
        "min_decay_fit_r2": { "type": "number", "minimum": 0, "maximum": 1 },
        "reference_force_rms_n": { "type": "number", "exclusiveMinimum": 0 },
        "uncertainty_floor": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "frequency_hz": { "type": "number", "minimum": 0 },
            "magnitude_db": { "type": "number", "minimum": 0 },
            "phase_deg": { "type": "number", "minimum": 0 },
            "t60_s": { "type": "number", "minimum": 0 },
            "acoustic_level_db": { "type": "number", "minimum": 0 },
            "acoustic_phase_deg": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["acoustic_records"],
        "properties": { "acoustic_records": { "minItems": 1 } }
      },
      "then": {
        "required": ["calibrator"],
        "properties": {
          "channels": { "required": ["microphone"] },
          "evidence": {
            "contains": {
              "type": "object",
              "properties": { "role": { "const": "acoustic_calibration" } },
              "required": ["role"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "force_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitivity_v_per_n"],
      "properties": {
        "column": { "type": "string", "minLength": 1 },
        "polarity": { "type": "number" },
        "delay_s": { "type": "number" },
        "full_scale_v": { "type": "number", "exclusiveMinimum": 0 },
        "sensitivity_v_per_n": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "response_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitivity_v_per_si"],
      "properties": {
        "column": { "type": "string", "minLength": 1 },
        "polarity": { "type": "number" },
        "delay_s": { "type": "number" },
        "full_scale_v": { "type": "number", "exclusiveMinimum": 0 },
        "sensitivity_v_per_si": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "microphone_channel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "column": { "type": "string", "minLength": 1 },
        "polarity": { "type": "number" },
        "delay_s": { "type": "number" },
        "full_scale_v": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "structural_record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "path_glob": { "type": "string", "minLength": 1 },
        "time_column": { "type": "string", "minLength": 1 },
        "force_column": { "type": "string", "minLength": 1 },
        "response_column": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["path"], "not": { "required": ["path_glob"] } },
        { "required": ["path_glob"], "not": { "required": ["path"] } }
      ]
    },
    "acoustic_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius_m", "azimuth_deg", "elevation_deg"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "path_glob": { "type": "string", "minLength": 1 },
        "time_column": { "type": "string", "minLength": 1 },
        "force_column": { "type": "string", "minLength": 1 },
        "response_column": { "type": "string", "minLength": 1 },
        "radius_m": { "type": "number", "exclusiveMinimum": 0 },
        "azimuth_deg": { "type": "number", "minimum": -180, "maximum": 360 },
        "elevation_deg": { "type": "number", "minimum": -90, "maximum": 90 }
      },
      "oneOf": [
        { "required": ["path"], "not": { "required": ["path_glob"] } },
        { "required": ["path_glob"], "not": { "required": ["path"] } }
      ]
    }
  }
}
